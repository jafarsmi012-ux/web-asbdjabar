# 1 hari (bukan immutable): ganti footage hero cukup tunggu 1x TTL, tanpa purge manual.
/asbd/hero/*
  Cache-Control: public, max-age=86400, must-revalidate

# Bukan immutable: gambar CMS bisa diganti dengan nama file sama.
/images/uploads/*
  Cache-Control: public, max-age=600, must-revalidate

# Konten CMS: selalu revalidasi supaya edit cepat terlihat setelah deploy.
/data/*
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
